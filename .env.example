# PMAgent 서버 환경 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8082

# 데이터 저장 설정
DATA_DIR=./data

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=pmagent.log

# 보안 설정
# ⚠️ 필수: 강력한 관리자 비밀번호 설정 (최소 12자 이상 권장)
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password_here

# API 키 (실제 환경에서는 강력한 무작위 값으로 변경하세요)
API_KEY=your_secret_api_key_here
ENABLE_AUTH=false

# Ollama API 설정
OLLAMA_API_BASE=http://localhost:11434/api
OLLAMA_MODEL=llama3.2:latest

# Koyeb 배포 설정 (클라우드 배포 시)
# KOYEB_APP_NAME=your-app-name
# WEB_CONCURRENCY=1

# 기타 설정
DEBUG=false
MAX_TASKS_PER_PROJECT=100 